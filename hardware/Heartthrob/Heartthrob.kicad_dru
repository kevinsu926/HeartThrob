(version 1)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.1mm))
)
(rule "Minimum connection width 1"
	(constraint connection_width (min 0.15mm))
)
# Copper pours keep 0.25 mm from other nets (matches the zones' own setting).
# Without this, the 0.1 mm rule above also applies to the pours, so pads with
# 0.1 mm solder-mask expansion end up exposing the GND pour (mask bridge).
(rule "Pour clearance"
	(condition "A.Type == 'Zone' || B.Type == 'Zone'")
	(constraint clearance (min 0.25mm))
)
# JLCPCB 2-layer: via hole to copper >= 0.2 mm everywhere except the AD8233
# WLCSP, whose via-in-pad fan-out sits at 0.195 mm (board minimum set to 0.19).
(rule "Hole clearance outside AD8233"
	(condition "!A.memberOfFootprint('U1') && !B.memberOfFootprint('U1')")
	(constraint hole_clearance (min 0.2mm))
)
